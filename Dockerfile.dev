FROM python:3.12-slim

LABEL maintainer="Purrple-hub" \
      version="1.0.0" \
      description="SiteJS.py – the Python Small Web builder"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SITEJS_HOST=0.0.0.0 \
    SITEJS_PORT=4433 \
    SITEJS_SSL=true \
    SITEJS_WATCH=true \
    SITEJS_POLL_INTERVAL=0.3 \
    SITEJS_LOG_LEVEL=INFO

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    rsync \
    && rm -rf /var/lib/apt/lists/*

COPY sitejs.py /app/sitejs.py

RUN pip install --no-cache-dir \
    markdown \
    jinja2 \
    watchdog \
    cryptography \
    cssmin \
    jsmin \
    pillow \
    boto3 \
    paramiko \
    toml \
    && pip install --no-cache-dir websockets || true

RUN useradd -m -u 1000 sitejs && chown -R sitejs:sitejs /app
USER sitejs

EXPOSE 4433

ENTRYPOINT ["python", "/app/sitejs.py"]
CMD ["serve", "--host", "0.0.0.0", "--port", "4433"]
